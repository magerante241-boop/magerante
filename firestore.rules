rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == "x5LPz8ouBsYq3wZnXI7wIpYhuxw2";
    }

    function estGerantDe(estId) {
      return isSignedIn() && exists(/databases/$(database)/documents/establishments/$(estId)/gerants/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }

    match /establishments/{estId} {
      allow read: if isSignedIn() && (request.auth.uid == estId || isAdmin() || estGerantDe(estId));
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == estId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == estId || isAdmin());
      allow delete: if isSignedIn() && isAdmin();

      match /produits/{prodId} {
        allow read: if isSignedIn() && (request.auth.uid == estId || isAdmin() || estGerantDe(estId));
        allow write: if isSignedIn() && (request.auth.uid == estId || isAdmin() || estGerantDe(estId));
      }

      match /gerants/{gerantUid} {
        allow read, delete: if isSignedIn() && request.auth.uid == estId;
        allow read, update: if isSignedIn() && request.auth.uid == gerantUid;

        allow create: if isSignedIn() && (
          request.auth.uid == estId
          ||
          (
            request.auth.uid == gerantUid &&
            (
              (
                request.resource.data.viaToken is string &&
                get(/databases/$(database)/documents/invitations/$(request.resource.data.viaToken)).data.estId == estId
              )
              ||
              (
                request.resource.data.codeSaisi is string &&
                get(/databases/$(database)/documents/gerant_codes/$(request.resource.data.telephone)).data.estId == estId &&
                get(/databases/$(database)/documents/gerant_codes/$(request.resource.data.telephone)).data.code == request.resource.data.codeSaisi
              )
            )
          )
        );
      }

      match /ventes/{venteId} {
        allow read: if isSignedIn() && (request.auth.uid == estId || isAdmin() || estGerantDe(estId));
        allow create: if isSignedIn() &&
              (request.auth.uid == estId || estGerantDe(estId) || isAdmin());
        allow update, delete: if isSignedIn() && (request.auth.uid == estId || estGerantDe(estId) || isAdmin());
      }

      match /factures/{factureId} {
        allow read: if isSignedIn() && (request.auth.uid == estId || isAdmin() || estGerantDe(estId));
        allow create: if isSignedIn() &&
              (request.auth.uid == estId || estGerantDe(estId) || isAdmin());
        allow update, delete: if isSignedIn() && (request.auth.uid == estId || estGerantDe(estId) || isAdmin());
      }

      match /meta/{metaId} {
        allow read: if isSignedIn() && (request.auth.uid == estId || isAdmin() || estGerantDe(estId));
        allow write: if isSignedIn() &&
              (request.auth.uid == estId || estGerantDe(estId) || isAdmin());
      }

      match /mouvements/{mvtId} {
        allow read: if isSignedIn() && (request.auth.uid == estId || isAdmin() || estGerantDe(estId));
        allow create: if isSignedIn() && (request.auth.uid == estId || estGerantDe(estId) || isAdmin());
        allow update, delete: if isSignedIn() && (request.auth.uid == estId || estGerantDe(estId) || isAdmin());
      }

      match /journal/{journalId} {
        allow read: if isSignedIn() && (request.auth.uid == estId || isAdmin());
        allow create: if isSignedIn() && (request.auth.uid == estId || estGerantDe(estId));
        allow update, delete: if isSignedIn() && (request.auth.uid == estId || estGerantDe(estId) || isAdmin());
      }

      match /rapports/{periode} {
        allow read: if isSignedIn() && (request.auth.uid == estId || isAdmin());
        allow create, update: if isSignedIn() && request.auth.uid == estId;
        allow delete: if false;
      }

      match /clotures/{clotureId} {
        allow read: if isSignedIn() && (request.auth.uid == estId || isAdmin());
        allow create: if isSignedIn() && estGerantDe(estId) && request.resource.data.gerantUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /notifications/{notifId} {
        allow read: if isSignedIn() && (
          request.auth.uid == estId ||
          isAdmin() ||
          (estGerantDe(estId) && resource.data.auteurId == request.auth.uid)
        );
        allow create: if isSignedIn() && (request.auth.uid == estId || estGerantDe(estId) || isAdmin());
        allow update: if isSignedIn() && (request.auth.uid == estId || estGerantDe(estId) || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lu"]);
        allow delete: if isSignedIn() && (request.auth.uid == estId || estGerantDe(estId) || isAdmin());
      }
    }

    match /{path=**}/produits/{prodId} {
      allow read: if isAdmin();
    }

    match /{path=**}/ventes/{venteId} {
      allow read: if isAdmin();
    }

    match /invitations/{token} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.estId == request.auth.uid;
      allow update, delete: if false;
    }

    match /gerant_logins/{telephone} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == request.resource.data.estId;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.estId || isAdmin());
    }

    match /gerant_codes/{telephone} {
      allow read: if false;
      allow write: if isSignedIn() && request.auth.uid == request.resource.data.estId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
