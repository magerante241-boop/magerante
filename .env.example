# ============================================
# MAGERANTE — .env.example
# TEMPLATE — Copier ce fichier en .env.local
# et remplir avec vos vraies valeurs
#
# ⚠️ NE JAMAIS COMMITTER .env.local sur Git !
# Ce fichier .env.example peut être commité
# ============================================

# --------- FIREBASE ---------
# Trouvez ces valeurs dans :
# console.firebase.google.com → Projet → Paramètres → Vos apps

VITE_FIREBASE_API_KEY=AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=magerante241.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=magerante241
VITE_FIREBASE_STORAGE_BUCKET=magerante241.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# --------- APPLICATION ---------
VITE_APP_ENV=development
# Valeurs possibles : development | staging | production

VITE_APP_NAME=MAGERANTE
VITE_APP_VERSION=1.0.0
VITE_API_URL=http://localhost:5173

# --------- FONCTIONNALITÉS ---------
VITE_ENABLE_ANALYTICS=false
# true en production, false en développement

VITE_ENABLE_APP_CHECK=false
# true en production pour sécuriser Firebase

VITE_OFFLINE_MODE=true
# Active le mode hors-ligne (recommandé pour le Gabon)

# --------- ÉMULATEURS ---------
VITE_USE_EMULATORS=false
# Mettre "true" pour tester avec Firebase Emulators en local
